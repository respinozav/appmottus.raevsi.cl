# Mottus Gym Backend Environment Variables Example
PROJECT_NAME="Mottus Gym API"
API_V1_STR="/api/v1"

# Database Configuration (Dedicated user 'usr_mottus' on RDS schema 'bdmottus')
DB_HOST=your-rds-host.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=usr_mottus
DB_PASSWORD=your_secure_password
DB_SCHEMA=bdmottus

DATABASE_URL=postgresql://usr_mottus:your_secure_password@your-rds-host.rds.amazonaws.com:5432/postgres

# Security & JWT
SECRET_KEY=generate_a_secure_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Frontend & Domain
FRONTEND_URL=https://appmottus.raevsi.cl
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://appmottus.raevsi.cl"]
